# Company Master Dashboard settings. Keep this file private: it holds the Google service-account key.

# Web server
PORT=3000
# Owner account: always an admin. Sign in with it first, then add everyone else in the Access tab.
# Without a password the dashboard opens only on this computer (localhost).
DASHBOARD_USER=alcove
DASHBOARD_PASSWORD=
# Where users, roles and the access matrix are saved (default: access.json next to server.js).
# On a host that wipes its disk on restart, point this at a persistent disk.
ACCESS_FILE=
# Optional: hours a sign-in lasts (default 12), and a fixed secret for sign-in cookies
SESSION_HOURS=12
SESSION_SECRET=

# Google data
SHEET_ID=1nK-tKjoSH2Y84YE-0rOIgQgvBA238mCUBp0fK5igdRg
ROC_FOLDER_ID=128CihawD0mDOwpsd2m1EIo5N40jzwAp0
# Folders searched for PAN cards and GST certificates (GST includes its subfolders)
PAN_FOLDER_ID=1l4Y_WnaUfaFSeElUvKBxXA-XLJd5UfQV
GST_FOLDER_ID=1W7kXNNf7X6vyuhiE-SlQrSSD_Fc22jSY

# Google service account
GOOGLE_PROJECT_ID=company-master-dashboard
GOOGLE_CLIENT_EMAIL=company-master-dashboard@company-master-dashboard.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
